# Copy to .env and replace every "change-me" value. Never commit .env.
COMPOSE_PROJECT_NAME=stayhotel

# Postgres superuser (only used by the init script and for admin tasks)
POSTGRES_PASSWORD=change-me

# pgAdmin web UI (opt-in "tools" profile). Email must have a real-looking domain (not .local).
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# One login role per service database
AUTH_DB_PASSWORD=change-me
HOTEL_DB_PASSWORD=change-me
BOOKING_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
REVIEW_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me

# JWT signing key for auth-service: base64 PKCS#8 DER RSA key (>= 2048 bit).
# Generate with: scripts/generate-jwt-key.sh
AUTH_JWT_PRIVATE_KEY=change-me
AUTH_JWT_KEY_ID=auth-key-1
# Refresh cookie "Secure" flag. Browsers accept Secure cookies on http://localhost; keep true everywhere else.
AUTH_COOKIE_SECURE=true

# Optional first administrator, created on first start if the email is unused.
# Password: 12-72 chars with letters and digits. Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated list of browser origins allowed by the API Gateway
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Sandbox payment provider: shared HMAC secret for signed webhooks (>= 32 chars), and the browser-facing origin
SANDBOX_WEBHOOK_SECRET=change-me-to-a-long-random-value-0000
PUBLIC_BASE_URL=http://localhost:4200

# Booking hold before an unpaid booking expires (ISO-8601 or 15m / 30s style)
BOOKING_HOLD_DURATION=15m

# Host ports
GATEWAY_PORT=8080
FRONTEND_PORT=4200
POSTGRES_PORT=5432
KAFKA_PORT=9094
PGADMIN_PORT=5050
MAILPIT_UI_PORT=8025

# Notification email (M5). Defaults deliver to the Mailpit container; set these for a real SMTP relay.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_FROM=no-reply@example.com
