# Copy to .env and replace every "change-me" value. Never commit .env.
COMPOSE_PROJECT_NAME=stayhotel

# Postgres superuser (only used by the init script and for admin tasks)
POSTGRES_PASSWORD=change-me

# One login role per service database
AUTH_DB_PASSWORD=change-me
HOTEL_DB_PASSWORD=change-me
BOOKING_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
REVIEW_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me

# Comma-separated list of browser origins allowed by the API Gateway
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Host ports
GATEWAY_PORT=8080
FRONTEND_PORT=4200
POSTGRES_PORT=5432
KAFKA_PORT=9094
