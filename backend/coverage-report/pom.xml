<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.stayhotel</groupId>
        <artifactId>stay-hotel-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>coverage-report</artifactId>
    <packaging>pom</packaging>
    <name>Stay Hotel :: Coverage Report</name>
    <description>Aggregated JaCoCo report (target/site/jacoco-aggregate): counts common-lib code exercised by service tests.</description>

    <dependencies>
        <dependency>
            <groupId>com.stayhotel</groupId>
            <artifactId>common-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.stayhotel</groupId>
            <artifactId>api-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.stayhotel</groupId>
            <artifactId>auth-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.stayhotel</groupId>
            <artifactId>hotel-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.stayhotel</groupId>
            <artifactId>booking-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.stayhotel</groupId>
            <artifactId>payment-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.stayhotel</groupId>
            <artifactId>review-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.stayhotel</groupId>
            <artifactId>notification-service</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
